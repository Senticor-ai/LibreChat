# LibreChat Environment Variables Example
# This file shows all the environment variables you can set for LibreChat
# Copy this to manifests/secret.yaml and fill in your actual values

# ===========================================================================
# SECURITY CREDENTIALS (REQUIRED)
# ===========================================================================

# Generate these with: openssl rand -hex 32
CREDS_KEY=your-32-char-hex-here
JWT_SECRET=your-32-char-hex-here
JWT_REFRESH_SECRET=your-32-char-hex-here
MEILI_MASTER_KEY=your-32-char-hex-here

# Generate with: openssl rand -hex 16
CREDS_IV=your-16-char-hex-here

# ===========================================================================
# LLM PROVIDER API KEYS
# ===========================================================================

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI (Gemini)
# GOOGLE_API_KEY=...

# Azure OpenAI
# AZURE_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# AWS Bedrock
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Cohere
# COHERE_API_KEY=...

# OpenRouter
# OPENROUTER_KEY=...

# Mistral AI
# MISTRAL_API_KEY=...

# Groq
# GROQ_API_KEY=...

# ===========================================================================
# DOMAIN CONFIGURATION
# ===========================================================================

DOMAIN_CLIENT=https://chat.example.com
DOMAIN_SERVER=https://chat.example.com

# ===========================================================================
# DATABASE CONFIGURATION
# ===========================================================================

# MongoDB (automatically configured when using Helm sub-chart)
MONGO_URI=mongodb://librechat-mongodb:27017/LibreChat

# For external MongoDB:
# MONGO_URI=mongodb://username:password@mongodb.example.com:27017/LibreChat?authSource=admin

# ===========================================================================
# REDIS CONFIGURATION (OPTIONAL)
# ===========================================================================

# For external Redis:
# REDIS_URI=redis://redis.example.com:6379

# ===========================================================================
# MEILISEARCH CONFIGURATION
# ===========================================================================

MEILI_HOST=http://librechat-meilisearch:7700
MEILI_NO_ANALYTICS=true

# ===========================================================================
# AUTHENTICATION SETTINGS
# ===========================================================================

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false

# Session configuration
SESSION_EXPIRY=900000  # 15 minutes (milliseconds)
REFRESH_TOKEN_EXPIRY=604800000  # 7 days (milliseconds)

# ===========================================================================
# SOCIAL LOGIN CREDENTIALS (OPTIONAL)
# ===========================================================================

# Google OAuth
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_CALLBACK_URL=https://chat.example.com/oauth/google/callback

# GitHub OAuth
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
# GITHUB_CALLBACK_URL=https://chat.example.com/oauth/github/callback

# Discord OAuth
# DISCORD_CLIENT_ID=...
# DISCORD_CLIENT_SECRET=...
# DISCORD_CALLBACK_URL=https://chat.example.com/oauth/discord/callback

# ===========================================================================
# FILE STORAGE (OPTIONAL)
# ===========================================================================

# Default is local storage. Configure S3 or Firebase for cloud storage.

# AWS S3
# S3_ENDPOINT=s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_BUCKET=librechat-uploads

# Firebase
# FIREBASE_PROJECT_ID=...
# FIREBASE_PRIVATE_KEY=...
# FIREBASE_CLIENT_EMAIL=...
# FIREBASE_STORAGE_BUCKET=...

# ===========================================================================
# EMAIL CONFIGURATION (OPTIONAL)
# ===========================================================================

# For password reset emails, etc.

# Gmail
# EMAIL_SERVICE=gmail
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=LibreChat <noreply@example.com>

# Custom SMTP
# EMAIL_SERVICE=smtp
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_ENCRYPTION=tls
# EMAIL_USERNAME=...
# EMAIL_PASSWORD=...
# EMAIL_FROM=LibreChat <noreply@example.com>

# ===========================================================================
# PLUGIN CONFIGURATION
# ===========================================================================

PLUGIN_MODELS=gpt-4,gpt-4-turbo-preview,gpt-3.5-turbo
DEBUG_PLUGINS=true

# ===========================================================================
# FILE UPLOAD SETTINGS
# ===========================================================================

FILE_UPLOAD_SIZE_LIMIT=50  # MB

# ===========================================================================
# DEBUG AND LOGGING
# ===========================================================================

NODE_ENV=production
DEBUG_CONSOLE=false
# DEBUG_LOGGING=true

# ===========================================================================
# RATE LIMITING (OPTIONAL)
# ===========================================================================

# LIMIT_CONCURRENT_MESSAGES=true
# CONCURRENT_MESSAGE_MAX=1

# ===========================================================================
# BALANCE SYSTEM (OPTIONAL)
# ===========================================================================

# CHECK_BALANCE=true
# BALANCE_ENDPOINT=https://api.example.com/balance

# ===========================================================================
# MCP SERVER CREDENTIALS (OPTIONAL)
# ===========================================================================

# If your MCP servers require OAuth
# MCP_CLIENT_ID=...
# MCP_CLIENT_SECRET=...
